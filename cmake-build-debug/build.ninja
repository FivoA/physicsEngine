# Link the static library thirdparty\imgui\libimgui.a

build thirdparty/imgui/libimgui.a: CXX_STATIC_LIBRARY_LINKER__imgui_Debug thirdparty/imgui/CMakeFiles/imgui.dir/backends/imgui_impl_wgpu.cpp.obj thirdparty/imgui/CMakeFiles/imgui.dir/backends/imgui_impl_glfw.cpp.obj thirdparty/imgui/CMakeFiles/imgui.dir/misc/cpp/imgui_stdlib.cpp.obj thirdparty/imgui/CMakeFiles/imgui.dir/imgui.cpp.obj thirdparty/imgui/CMakeFiles/imgui.dir/imgui_draw.cpp.obj thirdparty/imgui/CMakeFiles/imgui.dir/imgui_tables.cpp.obj thirdparty/imgui/CMakeFiles/imgui.dir/imgui_widgets.cpp.obj || thirdparty/glfw/src/libglfw3.a
  LANGUAGE_COMPILE_FLAGS = -g
  OBJECT_DIR = thirdparty\imgui\CMakeFiles\imgui.dir
  POST_BUILD = cd .
  PRE_LINK = cd .
  TARGET_FILE = thirdparty\imgui\libimgui.a
  TARGET_PDB = imgui.a.dbg


#############################################
# Utility command for edit_cache

build thirdparty/imgui/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D C:\Users\felly\CLionProjects\game-physics-template\cmake-build-debug\thirdparty\imgui && C:\Users\felly\AppData\Local\Programs\CLion\bin\cmake\win\x64\bin\cmake.exe -E echo "No interactive CMake dialog available.""
  DESC = No interactive CMake dialog available...
  restat = 1

build thirdparty/imgui/edit_cache: phony thirdparty/imgui/CMakeFiles/edit_cache.util


#############################################
